{
  "name": "dn-ioc",
  "version": "0.2.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "description": "A lightweight, type-safe Inversion of Control (IoC) dependency injection library for TypeScript, built with a functional programming paradigm.",
  "author": "MunMunMiao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MunMunMiao/dn-ioc.git"
  },
  "keywords": [
    "dependency injection",
    "ioc",
    "typescript",
    "functional programming"
  ],
  "homepage": "https://github.com/MunMunMiao/dn-ioc",
  "bugs": {
    "url": "https://github.com/MunMunMiao/dn-ioc/issues"
  },
  "scripts": {
    "build": "bun run scripts/build.ts && tsc",
    "test": "bun test",
    "test:coverage": "bun run scripts/check-coverage.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.typecheck.json",
    "type-check:watch": "tsc --noEmit -p tsconfig.typecheck.json --watch"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0",
    "@biomejs/biome": "^2.2.5"
  }
}
